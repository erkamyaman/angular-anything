{
  "name": "angular-anything",
  "version": "0.1.0",
  "description": "Move your app or library to Angular with agents, and prove it still behaves the same.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/erkamyaman/angular-anything.git"
  },
  "type": "module",
  "bin": {
    "angular-anything": "dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "aa": "node src/cli.ts",
    "typecheck": "tsc --noEmit",
    "build": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\" && tsc -p tsconfig.build.json",
    "prepack": "node --run build",
    "test": "node --test \"test/**/*.test.ts\"",
    "fixtures:build": "pnpm -r run build",
    "fixtures:serve": "node fixtures/server.ts"
  },
  "dependencies": {
    "playwright": "1.65.1"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "typescript": "~6.0.2"
  }
}
