{
  "format": "angular-anything/case@1",
  "id": "filter-tabs",
  "description": "Show the active tasks, the done tasks and all tasks again",
  "viewport": { "width": 1024, "height": 768 },
  "steps": [
    { "action": "goto", "path": "/" },
    { "action": "click", "target": { "role": "tab", "name": "Active" } },
    { "action": "click", "target": { "role": "tab", "name": "Done" } },
    { "action": "click", "target": { "role": "tab", "name": "All" } }
  ]
}
