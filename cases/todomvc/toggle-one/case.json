{
  "format": "angular-anything/case@1",
  "id": "toggle-one",
  "description": "Toggle the second todo, the count goes down, toggle it back",
  "viewport": {
    "width": 1024,
    "height": 768
  },
  "steps": [
    {
      "action": "goto",
      "path": "/"
    },
    {
      "action": "fill",
      "target": {
        "role": "textbox",
        "name": "New Todo Input"
      },
      "value": "Buy milk"
    },
    {
      "action": "press",
      "target": {
        "role": "textbox",
        "name": "New Todo Input"
      },
      "key": "Enter"
    },
    {
      "action": "fill",
      "target": {
        "role": "textbox",
        "name": "New Todo Input"
      },
      "value": "Walk the dog"
    },
    {
      "action": "press",
      "target": {
        "role": "textbox",
        "name": "New Todo Input"
      },
      "key": "Enter"
    },
    {
      "action": "check",
      "target": {
        "role": "checkbox",
        "within": {
          "role": "listitem",
          "index": 2
        }
      }
    },
    {
      "action": "uncheck",
      "target": {
        "role": "checkbox",
        "within": {
          "role": "listitem",
          "index": 2
        }
      }
    }
  ]
}
